# Copy this file to .env and fill in real values. Never commit .env.

# --- Server ---
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# --- Database ---
# Local dev uses the portable Postgres in tools/ (see tools/README.md).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/hirelens"

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=hirelens_session

# --- AI provider ---
# Leave ANTHROPIC_API_KEY unset to run the AI subsystem in mock mode
# (deterministic matching still runs for real; parsing/explanation text is templated).
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- File storage ---
# STORAGE_DRIVER=local | cloudinary
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
